{
  "name": "facefusion-app",
  "version": "1.0.9",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev:app": "uni -p app",
    "dev:app-android": "uni -p app-android",
    "dev:app-ios": "uni -p app-ios",
    "dev:h5": "uni",
    "dev:mp-kuaishou": "uni -p mp-kuaishou",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:app": "uni build -p app --mode production",
    "build:app-android": "uni build -p app-android --mode production",
    "build:app-ios": "uni build -p app-ios --mode production",
    "build:h5": "uni build --mode production",
    "build:mp-kuaishou": "uni build -p mp-kuaishou --mode production",
    "build:mp-weixin": "uni build -p mp-weixin --mode production",
    "type-check": "vue-tsc --noEmit",
    "test": "node --test build/config.test.mjs",
    "check": "yarn type-check && yarn test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-app-plus": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-h5": "3.0.0-4070620250821001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-4070620250821001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4070620250821001",
    "crypto-js": "^4.2.0",
    "uview-plus": "^3.4.16",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4070620250821001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4070620250821001",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.8.1",
    "@uni-helper/unocss-preset-uni": "^0.2.10",
    "@unocss/core": "0.63.6",
    "@unocss/preset-legacy-compat": "0.63.6",
    "@unocss/rule-utils": "0.63.6",
    "postcss": "^8.4.21",
    "sass": "1.69.5",
    "typescript": "^4.9.4",
    "unocss": "0.63.6",
    "unocss-applet": "^0.8.5",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
