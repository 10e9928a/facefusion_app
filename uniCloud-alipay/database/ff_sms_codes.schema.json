{
  "bsonType": "object",
  "required": ["phone", "code", "expires_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "phone 作为主键"
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号"
    },
    "code": {
      "bsonType": "string",
      "description": "6 位验证码"
    },
    "expires_at": {
      "bsonType": "timestamp",
      "description": "过期时间"
    },
    "last_sent_at": {
      "bsonType": "timestamp",
      "description": "上次发送时间(频控)"
    },
    "attempts": {
      "bsonType": "int",
      "description": "验证失败次数",
      "defaultValue": 0
    }
  }
}
